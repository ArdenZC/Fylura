+
+pub const PRODUCT_BUSY_TIMEOUT_MS: u64 = 5_000;
+pub const PRODUCT_POOL_SIZE: u32 = 8;
+
+#[derive(Deserialize, Serialize, Clone, Debug)]
+pub struct SlotManifest {
+    pub format_version: u32,
+    pub slot_id: String,
+    pub document_count: usize,
