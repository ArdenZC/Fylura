{
  "name": "fylura",
  "version": "0.1.40",
  "private": true,
  "description": "A local-first personal digital asset steward.",
  "author": "Startlan",
  "homepage": "https://github.com/ArdenZC/Fylura",
  "copyright": "Copyright © 2026 Startlan",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --features desktop-runtime",
    "build": "node scripts/buildWindowsPackage.mjs",
    "build:frontend": "vite build",
    "build:native-preview-handler": "node scripts/buildWindowsPreviewHandler.mjs",
    "check:rust:release": "cargo check --release --manifest-path src-tauri/Cargo.toml --features desktop-runtime",
    "build:check": "npm run build:frontend && npm run check:rust:release",
    "test": "vitest run",
    "test:browser:w2-01:contract": "vitest run tests/w2-01BrowserGateContract.test.ts",
    "test:browser:w2-01:real": "node scripts/runW2-01BrowserGate.mjs",
    "test:browser:w2-04:real": "node scripts/runW2-04BrowserGate.mjs",
    "test:browser:w2-05:real": "node scripts/runW2-05BrowserGate.mjs",
    "test:browser:w2-06:real": "node scripts/runW2-06BrowserGate.mjs",
    "test:browser:w2-07:real": "node scripts/runW2-07BrowserGate.mjs",
    "test:browser:w2-08:real": "node scripts/runW2-08BrowserGate.mjs",
    "test:browser:w2-09:real": "node scripts/runW2-09BrowserGate.mjs",
    "test:browser:w2-10:real": "node scripts/runW2-10BrowserGate.mjs",
    "test:browser:w2-11:real": "node scripts/runW2-11BrowserGate.mjs",
    "test:browser:cleanup-visibility:real": "node scripts/runCleanupVisibilityBrowser.mjs",
    "test:browser:w3-02:real": "node scripts/runW3-02BrowserGate.mjs",
    "test:browser:w3-03:real": "node scripts/runW3-03BrowserGate.mjs",
    "test:browser:w3-04:real": "node scripts/runW3-04BrowserGate.mjs",
    "test:browser:w3-05:real": "node scripts/runW3-05BrowserGate.mjs",
    "test:browser:w3-06:real": "node scripts/runW3-06BrowserGate.mjs",
    "test:browser:w3-10:phase-a": "node scripts/runW3-10PhaseABrowserHarness.mjs",
    "test:browser:w3-10:real": "node scripts/runW3-10BrowserGate.mjs",
    "test:browser:w3-07:real": "node scripts/runW3-07BrowserGate.mjs",
    "test:browser:w3-08:real": "node scripts/runW3-08BrowserGate.mjs",
    "test:browser:w3-09:real": "node scripts/runW3-09BrowserGate.mjs",
    "test:browser:w2-01": "npm run test:browser:w2-01:contract && npm run test:browser:w2-01:real",
    "test:docs": "node scripts/checkDocumentation.mjs && node scripts/checkProjectGovernance.mjs",
    "test:governance": "node scripts/checkProjectGovernance.mjs",
    "test:remediation": "vitest run tests/remediationContract.test.ts",
    "test:performance": "node scripts/runPerformanceProfile.mjs --profile=full",
    "test:performance:pr": "node scripts/runPerformanceTestPr.mjs",
    "test:performance:architecture": "node scripts/checkPerformanceArchitecture.mjs",
    "test:performance:extended": "node scripts/runPerformanceProfile.mjs --profile=extended",
    "test:performance:full": "node scripts/runPerformanceProfile.mjs --profile=full",
    "typecheck": "tsc -p tsconfig.json",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:rust": "cargo audit --file src-tauri/Cargo.lock && cargo audit --file src-tauri/native/Cargo.lock",
    "verify:frontend": "npm run typecheck && npm test && npm run test:remediation && npm run test:performance:architecture && npm run build:frontend",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo test --manifest-path src-tauri/Cargo.toml --features desktop-runtime && cargo clippy --manifest-path src-tauri/Cargo.toml --features desktop-runtime --all-targets -- -D warnings",
    "verify:security": "npm run security:audit && npm run security:audit:rust",
    "verify": "npm run verify:frontend && npm run verify:rust && npm run verify:security",
    "assets:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generateBrandAssets.ps1",
    "test:browser:u3": "node scripts/runU3FileLibraryBrowser.mjs",
    "test:browser:ux04": "node scripts/runUX04FileFirstBrowser.mjs",
    "test:browser:u4": "node scripts/runU4FileLibraryBrowser.mjs",
    "test:browser:u5": "node scripts/runU5FileLibraryBrowser.mjs",
    "dev:preflight": "node scripts/devPreflight.mjs",
    "dev:ci-failure": "node scripts/ciFailureDigest.mjs",
    "dev:ci-metrics": "node scripts/ciRunMetrics.mjs",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --features desktop-runtime --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/native/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/native/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.40.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
