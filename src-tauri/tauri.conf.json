{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fylura",
  "version": "0.1.40",
  "identifier": "com.startlan.fylura",
  "build": {
    "beforeDevCommand": "vite --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:frontend && npm run build:native-preview-handler",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "../build/icon.png",
      "../build/icon.ico",
      "../build/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../build/installerIcon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    }
  }
}
